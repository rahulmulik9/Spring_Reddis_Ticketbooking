                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "const token = json.token || json.accessToken || json.jwt;",
                  "pm.collectionVariables.set(\"adminToken\", token);"
